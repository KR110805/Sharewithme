<IfModule mod_php.c>
    php_value upload_max_filesize 500M
    php_value post_max_size 500M
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 500M
    php_value post_max_size 500M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 500M
    php_value post_max_size 500M
</IfModule>
